    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.8.*" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.15.*" />
    <PackageReference Include="YamlDotNet" Version="16.3.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AuxiliumAPI\AuxiliumSoftware.AuxiliumServices.API.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
